#Ignore Filetypes
*.log
*.bin
*.gguf
*.onnx

#Ignore sensitive files
#Ollama Keys
id_ed25519
id_ed25519.pub

# Ignore python virtual environments
venv/
.venv/

# Ignore local environment files
__pycache__/
.env

# Ignore Interrupted downloads
*.partial
*.partial-*

# Ignore AI Models
models/

# Ignore the copies Update makes of the services' own data
backups/

# Ignore your own settings for ai-leverage (the .template next to each stays)
config/*.conf

# Ignore what ai-leverage looked up and can look up again
cache/

# Ignore each service's own data (settings, chats, uploads, keys)
stack/**/data/
stack/**/output/

# Ignore each service's update notes (the version Revert goes back to, the hold)
stack/**/update/

# Ignore each app's own data (revert points, backups)
apps/**/data/
