/* ai-leverage/src/python/menu.tcss
 * How manage.sh's menu is laid out and coloured. The colours come from the
 * theme ($primary, $success...), so every theme (ctrl+p → Theme) keeps their
 * meaning: green runs, yellow wants attention, red is a problem.
 */

Screen {
    layout: vertical;
}

/* A box with its title in the frame: the PC, the list, the panes */
.panel {
    background: $surface;
    border: round $foreground 20%;
    border-title-color: $text-muted;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    padding: 0 1;
}
.panel:focus, .panel:focus-within {
    border: round $border;
    border-title-color: $text;
}

#system {
    height: auto;
    border-title-color: $text-primary;
    border-subtitle-align: right;
}

/* The menu bar at the top, like an app's, framed like the panels, so the
   gap under it is the same as between them. No padding: a title's word then
   lines up with the text in the panels (its highlight takes the space). */
#menubar {
    height: auto;
    padding: 0;
}

/* An open menu, under its title; the menu around it stays as it is */
MenuDropdown {
    background: transparent;
    align: left top;
}
/* A menu, and the menu beside it (▸); each placed where it belongs */
.menu-box {
    position: absolute;
    height: auto;
    background: $surface;
    border: round $border;
    padding: 0;
}
#submenu {
    display: none;
}
.menu-box DropList, .menu-box DropList:focus {
    height: auto;
    border: none;
    padding: 0;
    background: $surface;
}
.menu-box DropList > .option-list--option {
    padding: 0;
}

/* The main area under the PC's panel. From 160 columns, three columns side
   by side, the same height: the list, the highlighted entry's log, and the
   notifications; the list and the notifications keep their widths and the
   log gets the rest. Narrower, the list and the log side by side, and the
   notifications in a row along the bottom, their cards side by side. */
#main {
    height: 1fr;
    layout: grid;
    grid-size: 2 2;
    grid-columns: 2fr 3fr;
    grid-rows: 1fr 6;
}
Screen.-wide #main {
    grid-size: 3 1;
    grid-columns: 64 1fr 44;
    grid-rows: 1fr;
}
#stack, #log, #notices {
    width: 100%;
    height: 100%;
}

JumpList {
    background: $surface;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
}
/* The box around a list already shows where you are; no tint inside it */
JumpList:focus {
    background-tint: $foreground 0%;
}
JumpList > .option-list--option {
    padding: 0 1;
}
/* The highlight is a band behind the text, so the colours in it stay readable:
   strong in the list in use, faint where the choice is kept for later */
JumpList > .option-list--option-highlighted {
    background: $primary 18%;
    color: $foreground;
    text-style: none;
}
JumpList:focus > .option-list--option-highlighted {
    background: $primary 38%;
    color: $foreground;
    text-style: bold;
}
JumpList > .option-list--option-hover {
    background: $primary 10%;
}

/* The log, and a notification's log: text, scrolled; their controls sit in
   the frame. The scrollbar's track is the panel's own colour, so it reads as
   part of the panel, not as a gap next to it. */
Pane {
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    link-color: initial;
    link-style: none;
    link-color-hover: initial;
    link-style-hover: none;
    link-background-hover: $foreground 12%;
}
Pane:focus {
    background-tint: $foreground 0%;
}

/* The notifications: a card each, the newest at the top, coloured by how
   it's doing (yellow runs, green done, red failed) */
#notices {
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
}
#notices:focus {
    background-tint: $foreground 0%;
}
#notices-empty {
    height: auto;
    padding: 0 1;
}
/* The row along the bottom, in a narrower terminal: the cards side by side,
   the newest at the left, three lines each, scrolled sideways */
Screen.-narrow #notices {
    column-span: 2;
    layout: horizontal;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 1;
}
Screen.-narrow #notices-empty {
    width: 1fr;
}
Screen.-narrow NoticeCard {
    width: 38;
    height: 3;
    margin: 0 1 0 0;
}
/* A short message: grey, since it needs nothing from you */
NoticeCard {
    height: auto;
    margin-bottom: 1;
    padding: 0 0 0 1;
    border-left: outer $foreground-muted;
    background: $foreground 5%;
}
/* Its script asks you something and waits */
NoticeCard.-asking {
    border-left: outer $primary;
    background: $primary 14%;
}
NoticeCard.-running, NoticeCard.-warning {
    border-left: outer $warning;
    background: $warning 10%;
}
NoticeCard.-done {
    border-left: outer $success;
    background: $success 8%;
}
NoticeCard.-failed {
    border-left: outer $error;
    background: $error 10%;
}
NoticeCard:hover {
    background-tint: $foreground 6%;
}
/* The card Enter opens, while the column has the focus: the list's highlight band */
#notices:focus NoticeCard.-cursor {
    background: $primary 38%;
}
CardText {
    width: 1fr;
    height: auto;
}
CloseButton {
    width: 3;
    height: 1;
    content-align: center top;
    color: $foreground-muted;
}
CloseButton:hover {
    color: $text;
    background: $error 50%;
}

/* A notification's whole log, in a window over the menu */
RunWindow {
    align: center middle;
    background: $background 50%;
}
#runwindow {
    width: 124;
    max-width: 96%;
    height: 90%;
}
#runlog {
    height: 1fr;
    border: round $border;
    border-subtitle-align: right;
}
/* What its script asks, under the log, in the colour of a card that waits */
#asking {
    height: auto;
    background: $surface;
    border: round $primary;
    border-title-color: $primary;
    border-subtitle-align: right;
    padding: 0 1;
}
#asking-question {
    margin-bottom: 1;
}
#asking-answers, #asking-answers:focus {
    height: auto;
    border: none;
    padding: 0;
    background: $surface;
}

/* A choice, over the menu, such as how many notifications to keep */
Choose {
    align: center middle;
    background: $background 50%;
}
#choose {
    width: 66;
    max-width: 90%;
    height: auto;
    background: $surface;
    border: round $border;
    border-title-color: $text;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    border-subtitle-align: right;
    padding: 1 2;
}
#choose-text {
    margin-bottom: 1;
}
#choices, #choices:focus {
    height: auto;
    border: none;
    padding: 0;
    background: $surface;
}

#keys {
    dock: bottom;
    height: 1;
    background: $panel;
    padding: 0 1;
}

/* What you can do with an entry, in a box over the menu */
ActionsMenu {
    align: center middle;
    background: $background 50%;
}
#popup {
    width: 78;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: round $border;
    border-title-color: $text;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    border-subtitle-align: right;
    padding: 0 2;
}
#popup-head {
    height: auto;
    margin: 1 0;
}
#popup-title {
    height: 1;
}
#popup-actions, #popup-actions:focus {
    height: auto;
    max-height: 18;
    border: none;
    padding: 0;
    background: $surface;
}
/* As high as its longest text needs (set as the box fills), so text wraps instead of being cut */
#popup-hint {
    height: auto;
    min-height: 3;
    margin-bottom: 1;
    border-top: solid $foreground 15%;
}

/* The update overview, in a bigger box over the menu */
UpdatesMenu {
    align: center middle;
    background: $background 50%;
}
#updates {
    width: 116;
    max-width: 96%;
    height: auto;
    max-height: 94%;
    background: $surface;
    border: round $border;
    border-title-color: $text;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    border-subtitle-align: right;
    padding: 0 2;
}
#updates-head {
    height: auto;
    margin: 1 0;
}
#updates-list, #updates-list:focus {
    height: auto;
    border: none;
    padding: 0;
    background: $surface;
}
#updates-hint {
    height: auto;
    min-height: 3;
    margin-bottom: 1;
    border-top: solid $foreground 15%;
}

/* A yes/no question, over the menu */
Confirm {
    align: center middle;
    background: $background 60%;
}
#dialog {
    width: 66;
    max-width: 90%;
    height: auto;
    background: $surface;
    border: round $warning;
    border-title-color: $warning;
    border-title-style: bold;
    padding: 1 2;
}
#question {
    margin-bottom: 1;
}
#answers, #answers:focus {
    height: auto;
    border: none;
    padding: 0;
    background: $surface;
}

/* Facts in a box over the menu, such as About */
InfoBox {
    align: center middle;
    background: $background 50%;
}
#infobox {
    width: 84;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: round $border;
    border-title-color: $text;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    border-subtitle-align: right;
    padding: 1 2;
}

/* A README, full screen */
#page {
    height: 1fr;
    background: $surface;
    border: round $border;
    border-title-color: $text;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    border-subtitle-align: right;
    padding: 0 2;
}
#reader-keys {
    dock: bottom;
    height: 1;
    background: $panel;
    padding: 0 1;
}

/* The model fit, full screen: what you need at the top, the models for it,
   and the one the list highlights in the panel under them, as high as it
   needs and at most a little under half the screen (the mouse scrolls the
   rest). The screen itself never scrolls, so the rows keep their width. */
/* Text in the panels starts where the lists' text does, one column in */
#fit-goal {
    height: auto;
    padding: 0 2;
    border-subtitle-align: right;
    link-color: initial;
    link-style: none;
    link-color-hover: initial;
    link-style-hover: none;
    link-background-hover: $foreground 12%;
}
FitScreen {
    overflow: hidden;
}
#fit-models {
    height: 1fr;
    min-height: 6;
    border-subtitle-align: right;
}
#fit-head, #fit-ways-head {
    height: 1;
}
#fit-list, #fit-list:focus {
    height: 1fr;
    border: none;
    padding: 0;
}
#fit-detail {
    height: auto;
    max-height: 45%;
    border-subtitle-align: right;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
}
#fit-ways, #fit-ways:focus {
    height: auto;
    border: none;
    padding: 0;
}
#fit-more {
    height: auto;
    margin-top: 1;
    padding: 0 1;
}
#fit-keys {
    dock: bottom;
    height: 1;
    background: $panel;
    padding: 0 1;
}

/* A context size of your own, asked over the fit */
SizeBox {
    align: center middle;
    background: $background 50%;
}
#sizebox {
    width: 66;
    max-width: 90%;
    height: auto;
    background: $surface;
    border: round $border;
    border-title-color: $text;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    border-subtitle-align: right;
    padding: 1 2;
}
#sizebox-text {
    margin-bottom: 1;
}
/* Framed like the panels, the frame lit while you type */
#sizebox-input {
    height: 3;
    background: $surface;
    border: round $foreground 20%;
    padding: 0 1;
}
#sizebox-input:focus {
    border: round $border;
    background-tint: $foreground 0%;
}
#sizebox-why {
    height: auto;
    margin-top: 1;
}
