# Hugging Face settings for this machine only. To use them:
#   cp .env.template .env
# .env is ignored by git, so your token never ends up in the public repo.
#
# Everything here is optional. Without a .env, sync_models.sh downloads the
# public models in models.txt and skips the gated ones.

# Access token, needed only for gated models (marked GATED| in models.txt).
# Create one at https://huggingface.co/settings/tokens ("Read" is enough) and
# accept each gated model's terms on its page first.
#HF_TOKEN=hf_your_token_here

# Download only some of a model's files. Patterns are separated by spaces or
# commas. By default everything is downloaded, which is what vLLM needs to
# start without going online. Example: skip duplicate weights in other formats.
#HF_INCLUDE=""
#HF_EXCLUDE="*.pth *.bin original/*"

# Set to 'true' to hide the progress bars.
#HF_QUIET=false
