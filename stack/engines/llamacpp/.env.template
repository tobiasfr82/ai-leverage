# llama.cpp settings for this machine only. .env is ignored by git, so nothing
# in it ends up in the public repo. To use them:
#   cp .env.template .env
# After a change, Start the service again (manage.sh -> Start) to apply it.
#
# Everything here is optional. llama.cpp needs no model chosen in advance: it
# lists every GGUF model the Hugging Face downloader fetched, and loads the one
# you pick in Open WebUI.

# Longest conversation in tokens, input plus output (default 65536). Every model
# gets this much, or its own maximum if that is lower. More of it takes more GPU
# memory, so more of a big model moves to the PC's memory, which is slower. If a
# model can't load with it, its log says so: lower it.
#CONTEXT_SIZE=65536

# GPU memory in MB that llama.cpp leaves free when it loads a model (default
# 4096 = 4 GB), for Docling and Open WebUI's document search, which use the GPU
# too. llama.cpp fills the rest: the model, the conversation, and then as much
# of a big model as fits. The part that doesn't fit goes to the PC's memory.
#VRAM_KEEP_FREE=4096

# Seconds without a request before llama.cpp unloads the model, freeing the
# GPU for the other engines (default 1800 = 30 minutes). The next chat loads it
# again. -1 keeps it loaded until llama.cpp stops.
#IDLE_UNLOAD_SECONDS=1800

# Extra llama.cpp options, written as you would type them after "llama-server".
# They apply to every model, and come last, so they win over the settings above.
# For example, to store the conversation memory at half the size, which fits
# twice the conversation in the same memory:
#LLAMACPP_EXTRA_ARGS="--cache-type-k q8_0 --cache-type-v q8_0"
# Or to choose yourself how many layers of a big model keep their experts in the
# PC's memory, instead of letting llama.cpp work it out:
#LLAMACPP_EXTRA_ARGS="--n-cpu-moe 20"

# Port on this PC (default 8080). Change it if something else already uses it.
#LLAMACPP_PORT=8080

# llama.cpp build. The default, "server-cuda", is the newest, and Update
# moves to each new one. To stay on one build, pick it from
# https://github.com/ggml-org/llama.cpp/releases (builds such as b11561) and
# use its server-cuda image, e.g. "server-cuda-b11561", as listed at
# https://github.com/ggml-org/llama.cpp/pkgs/container/llama.cpp.
# (Hold in the menu does the same without a file to edit.)
#LLAMACPP_IMAGE_TAG=server-cuda
