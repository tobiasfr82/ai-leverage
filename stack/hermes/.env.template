# Hermes settings for this machine only. To use them:
#   cp .env.template .env
# .env is ignored by git, so nothing in it ends up in the public repo.
# After a change, Start the service again (manage.sh -> Start) to apply it.

# The folder Hermes may read and change, such as your Obsidian vault. It shows
# up as /workspace inside the container, and Hermes sees nothing else of yours.
# Point it at a folder of vaults to give Hermes all of them.
# Default: data/workspace, an empty folder next to this file.
#HERMES_WORKSPACE=/home/you/notes/second-brain

# Your user and group ID, so the files Hermes writes stay yours (default 1000,
# the first user on most Linux systems). Check yours with: id -u; id -g
#HERMES_UID=1000
#HERMES_GID=1000

# Port on this PC (default 8642). Change it if something else already uses it.
#HERMES_PORT=8642

# Any other Hermes environment variable also works here. Do not set
# API_SERVER_KEY: Hermes keeps its own in data/.env, and that one wins.
