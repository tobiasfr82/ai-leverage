# Ollama settings for this machine only. To use them:
#   cp .env.template .env
# .env is ignored by git, so nothing in it ends up in the public repo.
# After a change, Start the service again (manage.sh -> Start) to apply it.
#
# Everything here is optional. Without a .env, Ollama sizes itself to your GPU,
# e.g. its context size: 4k tokens on cards under 24 GB, 32k on 24-47 GB and
# 256k on 48 GB and up. Uncomment a line only to override that.

# Port on this PC (default 11434). Change it if something else already uses it,
# such as an Ollama installed directly on this PC.
#OLLAMA_PORT=11434

# How much text a model can keep in mind at once, in tokens. More needs more
# VRAM. For one model only, set PARAMETER num_ctx in a specs/*.model file.
#OLLAMA_CONTEXT_LENGTH=32768

# Store the model's working memory (the KV cache) in a smaller format to fit a
# longer context: f16 (default), q8_0 (half the size, barely noticeable) or
# q4_0 (a quarter of the size, some quality loss). Needs flash attention.
#OLLAMA_FLASH_ATTENTION=1
#OLLAMA_KV_CACHE_TYPE=q8_0

# How many chats one model answers at the same time (default 1).
#OLLAMA_NUM_PARALLEL=1
