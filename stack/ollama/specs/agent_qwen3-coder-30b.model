# ==============================================================================
# AGENT MODEL: qwen3-coder:30b WITH A 128K WINDOW
# FILE: agent_qwen3-coder-30b.model  ->  builds "agent/qwen3-coder:30b"
# ==============================================================================
# For agents such as Hermes Agent (needs at least 64k) or VS Code's agent mode.
# They talk to Ollama's OpenAI-style /v1 address, which cannot ask for a context
# size, so the size is set here. Point the agent at "agent/qwen3-coder:30b" and tell it the
# context is 131072 tokens.

FROM qwen3-coder:30b

PARAMETER num_ctx 131072
