# Settings for this machine only. To use them:
#   cp .env.template .env
# .env is ignored by git, so nothing in it ends up in the public repo.
# Docker Compose reads .env when it creates the container, so recreate it
# after a change (manage.sh -> Rebuild, or docker compose up -d --force-recreate).

# Who can open Open WebUI on port 3000:
#   127.0.0.1  this PC only (default, also used when there is no .env)
#   0.0.0.0    also other devices on your network, e.g. a laptop at home.
#              Check the account settings first - see "Opening it to your
#              home network" in README.md.
OPENWEBUI_BIND_ADDRESS=127.0.0.1
