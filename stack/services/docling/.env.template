# Docling settings for this machine only. To use them:
#   cp .env.template .env
# .env is ignored by git, so nothing in it ends up in the public repo.
# After a change, Start it again (in the menu: its box → Start) to apply it.
#
# Everything here is optional; Docling works without a .env.

# Port on this PC (default 5001). Change it if something else already uses it.
#DOCLING_PORT=5001

# Seconds Docling may spend on one document when Open WebUI waits for the
# answer (default 120). Raise it if large PDFs fail with a timeout.
#DOCLING_SERVE_MAX_SYNC_WAIT=120

# Docling release (default: the one compose.yaml names). Update moves this to
# the newest release on GitHub and writes it here, Revert puts the one before
# back. To stay on one release, use Hold in the menu.
#DOCLING_IMAGE_TAG=v1.37.0

# Any other Docling Serve variable (DOCLING_SERVE_...) also works here.
