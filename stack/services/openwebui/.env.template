# Settings for this machine only. To use them:
#   cp .env.template .env
# .env is ignored by git, so nothing in it ends up in the public repo.
# After a change, Start the service again (manage.sh -> Start) to apply it.

# Who can open Open WebUI:
#   127.0.0.1  this PC only (default, also used when there is no .env)
#   0.0.0.0    also other devices on your network, e.g. a laptop at home.
#              Check the account settings first - see "Opening it to your
#              home network" in README.md.
OPENWEBUI_BIND_ADDRESS=127.0.0.1

# Port on this PC (default 3000). Change it if something else already uses it.
#OPENWEBUI_PORT=3000

# Keeps everyone logged in when the container is recreated (Update, Rebuild).
# Any long random text; create one with: openssl rand -hex 32
#WEBUI_SECRET_KEY=

# Hermes's API key, so Open WebUI can use Hermes as a model. Filled in by
# manage.sh -> hermes -> connect_openwebui. Like the settings in compose.yaml,
# it only counts on Open WebUI's very first start.
#HERMES_API_KEY=

# Set to true to see a notice in Open WebUI when a new version is out. It
# asks GitHub each time someone opens Open WebUI, so it's off by default.
#ENABLE_VERSION_UPDATE_CHECK=false

# Any other Open WebUI environment variable also works here. Most of them only
# count on the very first start, like the ones in compose.yaml.
