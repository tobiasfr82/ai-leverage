# vLLM settings for this machine only. .env is ignored by git, so nothing in it
# ends up in the public repo. ./set_model.sh creates .env from this file for
# you; or copy it yourself:
#   cp .env.template .env
# After a change, Start the service again (manage.sh -> Start) to apply it.

# The model vLLM serves - the one setting vLLM cannot guess. ./set_model.sh
# lists the models downloaded with stack/huggingface and writes your choice here.
HUGGINGFACE_MODEL=""

# Everything below is optional.

# Share of the GPU's memory vLLM claims when it starts, from 0 to 1 (default
# 0.85 = 85%). vLLM refuses to start unless that much is free, so the default
# leaves room for your desktop and Docling. Raise it on a GPU that does nothing else.
#VRAM_LIMIT=0.85

# Longest conversation in tokens, input plus output. "auto" (default) picks the
# longest that fits in the memory above. A number caps it, e.g. 32768.
#CONTEXT_SIZE=auto

# Extra vLLM options, written as you would type them after "vllm serve". A
# model's page on huggingface.co often lists the ones it needs, for example:
#VLLM_EXTRA_ARGS="--quantization modelopt --kv-cache-dtype fp8"

# Port on this PC (default 8000). Change it if something else already uses it.
#VLLM_PORT=8000

# vLLM build: "latest" (default, the stable release) or e.g. "nightly".
#VLLM_IMAGE_TAG=latest

# Gated models (ones whose terms you accepted on huggingface.co) need your
# token if vLLM has to fetch missing files. Same token as stack/huggingface/.env.
#HF_TOKEN=

# Any other vLLM environment variable (VLLM_...) also works here.
